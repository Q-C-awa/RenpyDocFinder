<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/colorPrimaryContainer"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="20dp"
    android:paddingEnd="18dp"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/drawer_title"
            android:textColor="?attr/colorOnPrimaryContainer"
            android:textSize="16sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/navCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_count_badge"
            android:paddingStart="9dp"
            android:paddingTop="2dp"
            android:paddingEnd="9dp"
            android:paddingBottom="2dp"
            android:textColor="?attr/colorOnPrimaryContainer"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- 语言切换（滑块动画） -->
    <FrameLayout
        android:id="@+id/langSwitch"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_segmented_track">

        <View
            android:id="@+id/langThumb"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="3dp"
            android:background="@drawable/bg_segmented_thumb" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/langZhLabel"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:gravity="center"
                android:text="@string/lang_zh"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/langEnLabel"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:gravity="center"
                android:text="@string/lang_en"
                android:textSize="14sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- 主题切换（一键切深浅色） -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/themeRow"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="10dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:gravity="center_vertical|start"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="@string/theme_dark"
        android:textColor="?attr/colorOnPrimaryContainer"
        android:textSize="13sp"
        app:icon="@drawable/ic_theme"
        app:iconGravity="textStart"
        app:iconSize="18dp"
        app:iconTint="?attr/colorOnPrimaryContainer" />

    <!-- 更新文档 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/updateRow"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:gravity="center_vertical|start"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="@string/menu_update"
        android:textColor="?attr/colorOnPrimaryContainer"
        android:textSize="13sp"
        app:icon="@drawable/ic_refresh"
        app:iconGravity="textStart"
        app:iconSize="18dp"
        app:iconTint="?attr/colorOnPrimaryContainer" />

    <TextView
        android:id="@+id/updateStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="?attr/colorOnPrimaryContainer"
        android:textSize="11sp" />
</LinearLayout>
