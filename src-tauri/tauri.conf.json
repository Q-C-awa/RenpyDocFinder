{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RenpyDocFinder",
  "version": "1.0.0",
  "identifier": "com.renpydoc.finder",
  "build": {
    "frontendDist": "../"
  },
  "app": {
    "windows": [
      {
        "title": "Renpy文档查询",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
